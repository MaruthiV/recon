# local compose db (port 5442), dev-only passwords match role names
RECON_DATABASE_URL=postgresql+asyncpg://recon_app:recon_app@localhost:5442/recon
RECON_OWNER_DATABASE_URL=postgresql+asyncpg://recon_owner:recon_owner@localhost:5442/recon
RECON_MCP_READ_DATABASE_URL=postgresql+asyncpg://recon_mcp_read:recon_mcp_read@localhost:5442/recon
SIM_DATABASE_URL=postgresql+asyncpg://sim_app:sim_app@localhost:5442/provider_sim
RECON_EVAL_DATABASE_URL=postgresql+asyncpg://recon_eval:recon_eval@localhost:5442/recon_eval

# gemini developer api, only needed for live runs
GEMINI_API_KEY=
RECON_LIVE=0
RECON_FAULTS=0

# skips adk's gce/mtls probe on mcp clients (3-9s per process otherwise)
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
# stateless mcp 2026-07-28 protocol
ADK_ENABLE_MCP_MODERN_PROTOCOL=1

# recon cli (dev defaults shown)
RECON_SIM_URL=http://localhost:8100
SIM_OPERATOR_TOKEN=sim-operator-dev
RECON_RUN_TOKEN_KEY=dev-run-token-key
# per-tenant provider keys, json {"t_acme": {"secret": "sk_...", "read": "rk_..."}}
RECON_PROVIDER_KEYS=
